# Copy this file to .env  (never commit .env, it holds secrets)
# Everything works with the defaults below: no keys needed, all mocks.

API_PORT=8787

# ---- Data role: mock | tiger
DATA_MODE=mock
DATABASE_URL=

# ---- Voice role: mock | elevenlabs
VOICE_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- AI (Voice & AI role): mock | gemini
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
