# Copy to .env (git ignores it). Everything works with the mocks and no keys.
DATA_MODE=mock
VOICE_MODE=mock
AI_MODE=mock

API_PORT=8787          # local only; hosts like Render set PORT themselves
CORS_ORIGIN=           # production: your frontend, e.g. https://fairfare.vercel.app (comma-separate several)

DATABASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=

# Web (set in Vercel, not here): VITE_API_URL=https://your-api.onrender.com
